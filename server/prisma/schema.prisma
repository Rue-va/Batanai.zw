generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  farmer
  buyer
  admin
}

enum LanguagePref {
  en
  sh
}

enum Season {
  rainy
  dry_winter
}

enum ListingStatus {
  active
  sold_out
  archived
}

enum TransactionStatus {
  Interested
  Negotiating
  Agreed
  Completed
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String?  @unique
  phone          String?  @unique
  passwordHash   String   @map("password_hash")
  role           Role
  farmName       String?  @map("farm_name")
  regionId       String?  @map("region_id")
  region         Region?  @relation(fields: [regionId], references: [id])
  languagePref   LanguagePref @default(en) @map("language_pref")
  rating         Decimal? @db.Decimal(2, 1)
  reviewCount    Int      @default(0) @map("review_count")
  verified       Boolean  @default(false)
  certifications String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  lastLoginAt    DateTime? @map("last_login_at")

  // One-time-or-occasionally-updated location, not continuous tracking —
  // set explicitly by the user (Geolocation API, with consent) or typed in
  // manually. latitude/longitude are precise and used only for server-side
  // distance sorting; they are NEVER returned on any buyer-facing endpoint
  // (see listings.routes.ts) — locationLabel (e.g. "Chinhoyi") is the only
  // thing shown to other users.
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  locationLabel  String?  @map("location_label")

  listings           Listing[]
  sentMessages       Message[]     @relation("sender")
  receivedMessages   Message[]     @relation("receiver")
  farmerTransactions Transaction[] @relation("farmerTransactions")
  buyerTransactions  Transaction[] @relation("buyerTransactions")
  refreshTokens      RefreshToken[]
  ratingsGiven       Rating[]      @relation("ratingsGiven")
  ratingsReceived    Rating[]      @relation("ratingsReceived")

  @@map("users")
}

model Region {
  id   String @id @default(uuid())
  name String @unique

  users       User[]
  listings    Listing[]
  adviceRules AdviceRule[]

  @@map("regions")
}

model Crop {
  id   String @id @default(uuid())
  name String @unique

  adviceRules AdviceRule[]

  @@map("crops")
}

model AdviceRule {
  id         String @id @default(uuid())
  cropId     String @map("crop_id")
  crop       Crop   @relation(fields: [cropId], references: [id])
  regionId   String @map("region_id")
  region     Region @relation(fields: [regionId], references: [id])
  season     Season
  planting   String
  watering   String
  fertilizer String
  pest       String

  @@unique([cropId, regionId, season])
  @@map("advice_rules")
}

model Listing {
  id          String        @id @default(uuid())
  farmerId    String        @map("farmer_id")
  farmer      User          @relation(fields: [farmerId], references: [id])
  crop        String
  grade       String?
  quantity    String
  unit        String
  price       Decimal       @db.Decimal(10, 2)
  marketPrice Decimal?      @map("market_price") @db.Decimal(10, 2)
  regionId    String?       @map("region_id")
  region      Region?       @relation(fields: [regionId], references: [id])
  photoUrl    String?       @map("photo_url")
  status      ListingStatus @default(active)
  views       Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")

  messages     Message[]
  transactions Transaction[]

  @@map("listings")
}

model Message {
  id         String    @id @default(uuid())
  listingId  String    @map("listing_id")
  listing    Listing   @relation(fields: [listingId], references: [id])
  senderId   String    @map("sender_id")
  sender     User      @relation("sender", fields: [senderId], references: [id])
  receiverId String    @map("receiver_id")
  receiver   User      @relation("receiver", fields: [receiverId], references: [id])
  body       String
  readAt     DateTime? @map("read_at")
  sentAt     DateTime  @default(now()) @map("sent_at")

  @@map("messages")
}

model Transaction {
  id          String             @id @default(uuid())
  listingId   String             @map("listing_id")
  listing     Listing            @relation(fields: [listingId], references: [id])
  farmerId    String             @map("farmer_id")
  farmer      User               @relation("farmerTransactions", fields: [farmerId], references: [id])
  buyerId     String             @map("buyer_id")
  buyer       User               @relation("buyerTransactions", fields: [buyerId], references: [id])
  quantity    String
  totalPrice  Decimal            @map("total_price") @db.Decimal(10, 2)
  status      TransactionStatus  @default(Interested)
  buyerRating Decimal?           @map("buyer_rating") @db.Decimal(2, 1)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  rating      Rating?

  @@map("transactions")
}

/// One rating per completed transaction, buyer -> farmer. Kept as its own
/// table (rather than reusing Transaction.buyerRating, which nothing ever
/// wrote to) so "who gave it, who received it, comment" is queryable
/// directly for both the admin view and a user's own received/given lists.
model Rating {
  id            String   @id @default(uuid())
  transactionId String   @unique @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  fromUserId    String   @map("from_user_id")
  fromUser      User     @relation("ratingsGiven", fields: [fromUserId], references: [id])
  toUserId      String   @map("to_user_id")
  toUser        User     @relation("ratingsReceived", fields: [toUserId], references: [id])
  value         Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("ratings")
}

/// Deliberately has no foreign key to User — participant_code is generated
/// client-side at consent time so research data can never be joined back to
/// a real identity, even with full database access.
model Feedback {
  id               String   @id @default(uuid())
  participantCode  String   @map("participant_code")
  triggerContext   String   @map("trigger_context")
  rating           Int
  comment          String?
  consentGiven     Boolean  @map("consent_given")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

/// Refresh tokens are stored hashed (never plaintext) so a database leak
/// alone doesn't hand out working tokens. Enables real revocation.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
