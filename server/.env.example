DATABASE_URL="postgresql://user:password@host:5432/agriconnect?schema=public&sslmode=require"
PORT=4000
NODE_ENV=development
# Comma-separated if you need more than one (e.g. localhost + a phone on your LAN IP).
# Each entry needs the scheme (http:// or https://) and no trailing slash.
CORS_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Optional: gates GET /api/feedback/export.csv. Omit to disable the export route.
ADMIN_EXPORT_TOKEN="replace-with-a-long-random-string"
